# ============================================================================
# TIKKA ORACLE CONFIGURATION
# ============================================================================
# See oracle/src/config/ENVIRONMENT_VARIABLES.md for complete documentation

# ----------------------------------------------------------------------------
# SERVER CONFIGURATION
# ----------------------------------------------------------------------------
PORT=3003
NODE_ENV=development

# ----------------------------------------------------------------------------
# STELLAR NETWORK CONFIGURATION (REQUIRED)
# ----------------------------------------------------------------------------
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_RPC_FALLBACK_URLS=
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
RAFFLE_CONTRACT_ID=

# ----------------------------------------------------------------------------
# KEY PROVIDER CONFIGURATION (REQUIRED)
# ----------------------------------------------------------------------------
# Options: env, aws-kms, gcp-kms
KEY_PROVIDER=env

# For KEY_PROVIDER=env (choose one):
ORACLE_SECRET_KEY=
ORACLE_PRIVATE_KEY=

# For KEY_PROVIDER=aws-kms:
# AWS_REGION=us-east-1
# AWS_KMS_KEY_ID=

# For KEY_PROVIDER=gcp-kms:
# GCP_PROJECT_ID=
# GCP_LOCATION_ID=global
# GCP_KEY_RING_ID=
# GCP_KEY_ID=
# GCP_KEY_VERSION=1

# ----------------------------------------------------------------------------
# QUEUE CONFIGURATION
# ----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
QUEUE_MAX_RETRIES=3
QUEUE_INITIAL_BACKOFF_MS=2000
QUEUE_BACKOFF_MULTIPLIER=2
QUEUE_MAX_BACKOFF_MS=60000
QUEUE_CONFIRMATION_TIMEOUT_MS=300000
QUEUE_MAX_CONCURRENCY=5
QUEUE_GENERATION_TIMEOUT_MS=30000
QUEUE_SUBMISSION_TIMEOUT_MS=120000

# ----------------------------------------------------------------------------
# VRF CONFIGURATION
# ----------------------------------------------------------------------------
# Prize amount threshold for using VRF instead of PRNG
VRF_THRESHOLD_XLM=500

# ----------------------------------------------------------------------------
# CIRCUIT BREAKER CONFIGURATION
# ----------------------------------------------------------------------------
# Number of consecutive Horizon SSE failures before the circuit opens
ORACLE_CB_FAILURE_THRESHOLD=5
# Milliseconds the circuit stays open before allowing a probe attempt
ORACLE_CB_RESET_TIMEOUT_MS=60000

# ----------------------------------------------------------------------------
# PRIORITY QUEUE CONFIGURATION
# ----------------------------------------------------------------------------
# Minimum prize amount (in XLM) for HIGH priority (Bull priority 1)
ORACLE_HIGH_VALUE_THRESHOLD_XLM=10000
# Minimum prize amount (in XLM) for MEDIUM priority (Bull priority 5)
# Must be less than ORACLE_HIGH_VALUE_THRESHOLD_XLM
ORACLE_MED_VALUE_THRESHOLD_XLM=1000

# Provider for keys: env, aws-kms, gcp-kms
KEY_PROVIDER=env

# GCP KMS Config
GCP_KMS_PROJECT=
GCP_KMS_KEY_PATH=

# Oracle Consensus Threshold
# Minimum number of oracles that must agree on the same randomness output
# Default: majority (Math.floor(N/2)+1 where N is total registered oracles)
# ORACLE_CONSENSUS_THRESHOLD=2

# Oracle Consensus Timeout (milliseconds)
# Maximum time to wait for oracle consensus before logging a warning
# Default: 30000 (30 seconds)
# ORACLE_CONSENSUS_TIMEOUT_MS=30000

# ----------------------------------------------------------------------------
# FEE CONFIGURATION
# ----------------------------------------------------------------------------
# Maximum transaction fee in stroops (default: 100000000 = 10 XLM)
# ORACLE_MAX_FEE_STROOPS=100000000
# Minimum transaction fee in stroops (default: 100)
# ORACLE_MIN_FEE_STROOPS=100
# Prize below this XLM uses minimum fee strategy (default: 500)
# LOW_STAKES_THRESHOLD_XLM=500

# ----------------------------------------------------------------------------
# TRANSACTION SUBMISSION
# ----------------------------------------------------------------------------
# Max submission attempts per transaction (default: 5)
# TX_SUBMIT_MAX_ATTEMPTS=5
# Initial backoff before retry in milliseconds (default: 1000)
# TX_SUBMIT_INITIAL_BACKOFF_MS=1000
# Webhook URL called on repeated submission failures
# TX_SUBMIT_ALERT_WEBHOOK_URL=

# ----------------------------------------------------------------------------
# MULTI-ORACLE (Advanced — leave defaults for single-oracle deployments)
# ----------------------------------------------------------------------------
ORACLE_MODE=single
MULTI_ORACLE_ENABLED=false
# LOCAL_ORACLE_ID=
# ORACLE_REGISTRY=
# ORACLE_PEERS=
# ORACLE_SECRETS=
# MULTI_ORACLE_THRESHOLD=
# ORACLE_MULTI_TIMEOUT_MS=10000

# ----------------------------------------------------------------------------
# SUPABASE (optional — required only when oracle audit logging is enabled)
# ----------------------------------------------------------------------------
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=

# ----------------------------------------------------------------------------
# ALERTING
# ----------------------------------------------------------------------------
# Options: none, pagerduty, opsgenie
ALERTING_PROVIDER=none
# Required when ALERTING_PROVIDER=pagerduty
# PAGERDUTY_ROUTING_KEY=
# Required when ALERTING_PROVIDER=opsgenie
# OPSGENIE_API_KEY=
# Generic alert webhook (used by any provider as fallback)
# ALERT_WEBHOOK_URL=

# ----------------------------------------------------------------------------
# HEARTBEAT
# ----------------------------------------------------------------------------
# How often to emit a heartbeat in milliseconds (default: 3600000 = 1 hour)
# HEARTBEAT_INTERVAL_MS=3600000
# Alert if no heartbeat received within this window in milliseconds (default: 90000)
# HEARTBEAT_ALERT_TIMEOUT_MS=90000

# ----------------------------------------------------------------------------
# EVENT LISTENER
# ----------------------------------------------------------------------------
# Initial reconnect delay on SSE disconnect in milliseconds (default: 1000)
# EVENT_LISTENER_INITIAL_RETRY_DELAY=1000
# Max reconnect delay in milliseconds (default: 60000)
# EVENT_LISTENER_MAX_RETRY_DELAY=60000
# Replay missed draw-request events on startup (default: false)
# ORACLE_DRAW_REQUEST_REPLAY=false

# ----------------------------------------------------------------------------
# LOGGING
# ----------------------------------------------------------------------------
# Level: error | warn | info | debug | verbose (default: info)
LOG_LEVEL=info
# Directory for log file output (default: ./logs)
LOG_DIR=./logs
# Echo logs to stdout (default: true)
LOG_TO_CONSOLE=true
# Max log file size before rotation (default: 20m)
# LOG_MAX_SIZE=20m
# Max log file age before deletion (default: 14d)
# LOG_MAX_FILES=14d
# Gzip rotated log files (default: true)
# LOG_ZIPPED_ARCHIVE=true

# ----------------------------------------------------------------------------
# See also: docs/env/README.md#3-oracle-port-3003
# ----------------------------------------------------------------------------
