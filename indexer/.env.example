# ============================================================================
# TIKKA INDEXER — Environment Configuration Example
# ============================================================================
# Copy to indexer/.env.local and fill in required values.
# See docs/env/README.md#2-indexer-port-3002 for full documentation.
# NEVER commit files with real secrets to version control.

# ----------------------------------------------------------------------------
# DATABASE (Required — use DATABASE_URL or individual DB_* vars)
# ----------------------------------------------------------------------------

# Option A — single connection string (preferred)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tikka_indexer

# Option B — individual vars (used when DATABASE_URL is not set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_DATABASE=tikka_indexer

# Set to "true" on Supabase / Railway / any TLS-required host
DB_SSL=false

# Optional: comma-separated read-replica URLs for leaderboard / read-heavy queries
# DATABASE_REPLICA_URL=postgres://postgres:postgres@replica1:5432/tikka_indexer

# Log queries slower than this threshold in milliseconds (default: 200)
# SLOW_QUERY_THRESHOLD_MS=200

# ----------------------------------------------------------------------------
# REDIS (used by webhook queue and cache)
# ----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ----------------------------------------------------------------------------
# STELLAR / BLOCKCHAIN (Required)
# ----------------------------------------------------------------------------

# Deployed Tikka raffle contract address to index
TIKKA_CONTRACT_ID=

# Stellar Horizon SSE endpoint for ledger streaming
# Default (mainnet): https://horizon.stellar.org
# Testnet:           https://horizon-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC endpoint (used for event decoding)
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ----------------------------------------------------------------------------
# SERVER
# ----------------------------------------------------------------------------
PORT=3002
NODE_ENV=development

# Bearer token for internal API endpoints (/admin, DLQ, snapshot).
# When set, the Swagger UI is also enabled.
# INTERNAL_API_KEY=

# ----------------------------------------------------------------------------
# INGESTION TUNING
# ----------------------------------------------------------------------------

# Max Soroban events processed per DB transaction (default: 25)
# INGESTION_BATCH_SIZE=25

# Ledgers to look back when detecting chain reorgs (default: 5)
# REORG_SAFETY_DEPTH=5

# Dry-run mode: log DB operations without committing (default: false)
# DRY_RUN=false

# ----------------------------------------------------------------------------
# HEALTH & ALERTING
# ----------------------------------------------------------------------------

# Ledger lag above this value is reported as "degraded" in /health (default: 100)
# LAG_THRESHOLD=100

# Ledger lag above this value triggers critical alerts and notifications (default: 50)
# INDEXER_LAG_ALERT_THRESHOLD_LEDGERS=50

# ----------------------------------------------------------------------------
# SUPABASE (required only when oracle audit log API is enabled)
# ----------------------------------------------------------------------------
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ----------------------------------------------------------------------------
# SNAPSHOTS / S3 (MinIO compatible)
# ----------------------------------------------------------------------------

# S3/MinIO URL for snapshot uploads and restores
# SNAPSHOT_STORAGE_URL=http://localhost:9000/tikka-snapshots

# AWS / MinIO credentials
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin

# ----------------------------------------------------------------------------
# MAINTENANCE TASKS
# ----------------------------------------------------------------------------

# Days to retain raffle events before archival (default: 30)
# RAFFLE_EVENTS_RETENTION_DAYS=30

# Rows per batch in archival/maintenance tasks (default: 500)
# BATCH_SIZE=500

# Hard cap on total batches processed in one archival run
# MAX_BATCH=

# Max retry attempts for event dispatch (default: 3)
# MAX_DISPATCH_RETRIES=3

# Base delay (ms) for exponential backoff on dispatch retries (default: 500)
# BASE_RETRY_DELAY_MS=500
